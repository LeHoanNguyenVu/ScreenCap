<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:ignore="UnusedResources">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Lớp phủ làm tối mờ xung quanh và để hở ô vuông ở giữa -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000" />

    <!-- Khung ngắm QR -->
    <FrameLayout
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center"
        android:background="@android:color/transparent">

        <!-- Ô vuông trắng trung tâm (để hở) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- 4 Góc của khung quét -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="#00BCD4"
            android:layout_gravity="top|start" />
        <View
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="#00BCD4"
            android:layout_gravity="top|start" />

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="#00BCD4"
            android:layout_gravity="top|end" />
        <View
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="#00BCD4"
            android:layout_gravity="top|end" />

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="#00BCD4"
            android:layout_gravity="bottom|start" />
        <View
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="#00BCD4"
            android:layout_gravity="bottom|start" />

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="#00BCD4"
            android:layout_gravity="bottom|end" />
        <View
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="#00BCD4"
            android:layout_gravity="bottom|end" />

        <!-- Tia quét chạy lên xuống -->
        <View
            android:id="@+id/scan_line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#00BCD4"
            android:layout_gravity="top" />

    </FrameLayout>

    <!-- Nhóm nút điều khiển bên phải -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:gravity="center"
        tools:ignore="RelativeOverlap">

        <!-- Nút Đóng (Góc PHẢI trên) -->
        <ImageButton
            android:id="@+id/btn_close_camera"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_bubble"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:elevation="10dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:contentDescription="Đóng Camera"
            app:tint="#FF5252"
            android:layout_marginBottom="16dp"/>

        <!-- Nút Đèn Flash -->
        <ImageButton
            android:id="@+id/btn_flash"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_bubble"
            android:src="@drawable/ic_flash"
            android:elevation="10dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:contentDescription="Bật/Tắt Flash"
            app:tint="#888888"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:background="@drawable/shape_button_rounded"
        android:backgroundTint="#AA000000"
        android:padding="12dp"
        android:text="📷 Đưa mã QR vào khung để quét"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</FrameLayout>
